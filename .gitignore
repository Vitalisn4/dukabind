# Model weights — never commit (ADTC rule)
model/*.gguf
model/*.bin
model/*.safetensors
# Keep checksum manifest
!model/SHA256SUMS.txt
!model/.gitkeep

# Local databases (seed from SQL; do not commit live shop data)
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
!data/.gitkeep

# macOS / editors
.DS_Store
.idea/
.vscode/

# Python
__pycache__/
*.pyc
.venv/
.venv311/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local profiler / bench raw dumps
submission.json
audit.json
benchmarks/raw/

# Vendored llama.cpp clone + build (rebuild via scripts/setup_llama.sh)
third_party/

# Secrets — never commit
.env
.env.*
!.env.example

